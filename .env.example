# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=garage_db
POSTGRES_USER=garage_user
POSTGRES_PASSWORD=change_me_in_prod

# ─── API ──────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# ─── JWT ──────────────────────────────────────────────────────────────────────
Jwt__Secret=your-super-secret-key-at-least-32-chars
Jwt__Issuer=GarageSystem
Jwt__Audience=GarageSystemUsers

# ─── Frontend ─────────────────────────────────────────────────────────────────
WEB_PORT=80
